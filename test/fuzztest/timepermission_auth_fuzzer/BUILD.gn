#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("../../../time.gni")

##############################fuzztest##########################################
ohos_fuzztest("TimePermissionAuthFuzzTest") {
  module_out_path = "time_service/time"

  include_dirs = [
    "${time_service_path}",
    "${time_service_path}/dfx/include",
    "${time_service_path}/time/include",
    "${time_utils_path}/native/include",
    "${api_path}/include",
    "${time_service_path}/timer/include",
    "${time_service_path}/time/include/inner_api_include",
  ]

  fuzz_config_file = "${time_root_path}/test/fuzztest/timepermission_auth_fuzzer"

  cflags_cc = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-c99-designator",
  ]

  sources = [
    "timepermission_auth_fuzzer.cpp",
  ]

  deps = [
    "${time_utils_path}:time_utils",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_single",
    "os_account:authorization_innerkits",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":TimePermissionAuthFuzzTest",
  ]
}
###############################################################################
