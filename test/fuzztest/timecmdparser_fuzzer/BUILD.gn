#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("../../../time.gni")

##############################fuzztest##########################################
ohos_fuzztest("TimeCmdParserFuzzTest") {
  module_out_path = "time_service/time"

  include_dirs = [
    "${time_service_path}/dfx/include",
  ]

  fuzz_config_file = "${time_root_path}/test/fuzztest/timecmdparser_fuzzer"

  cflags_cc = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-c99-designator",
    "-include",
    "functional",
    "-include",
    "memory",
    "-include",
    "stdio.h",
    "-include",
    "vector",
  ]

  sources = [
    "timecmdparser_fuzzer.cpp",
    "${time_service_path}/dfx/src/time_cmd_parse.cpp",
    "${time_service_path}/dfx/src/time_cmd_dispatcher.cpp",
  ]

  deps = []

  external_deps = []
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":TimeCmdParserFuzzTest",
  ]
}
###############################################################################
