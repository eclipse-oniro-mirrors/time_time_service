#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("../../../time.gni")

##############################fuzztest##########################################
ohos_fuzztest("NtpTrustedTimeStateFuzzTest") {
  module_out_path = "time_service/time"

  include_dirs = [
    "${time_service_path}",
    "${time_service_path}/dfx/include",
    "${time_service_path}/time/include",
    "${time_utils_path}/native/include",
    "${api_path}/include",
    "${time_service_path}/timer/include",
    "${time_service_path}/time/include/inner_api_include",
  ]

  fuzz_config_file = "${time_root_path}/test/fuzztest/ntptrustedtime_state_fuzzer"

  cflags_cc = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-c99-designator",
  ]

  sources = [
    "ntptrustedtime_state_fuzzer.cpp",
  ]

  deps = [
    "${time_service_path}:time_system_ability_static",
    "${api_path}:time_client",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:wantagent_innerkits",
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "bundle_framework:appexecfwk_core",
    "cJSON:cjson",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_single",
    "power_manager:powermgr_client",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]

  if (time_service_rdb_enable) {
    external_deps += [
      "relational_store:native_dataability",
      "relational_store:native_rdb",
    ]
  }
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":NtpTrustedTimeStateFuzzTest",
  ]
}
###############################################################################
