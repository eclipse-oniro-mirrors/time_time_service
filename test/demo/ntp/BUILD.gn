# On-device demo for the NTP engine innerkit. testonly so it never lands in a
# production image; build it explicitly with:
#   hb build --product-name rk3568 --build-target ntp_sync_demo

import("//build/ohos.gni")

ohos_executable("ntp_sync_demo") {
  testonly = true

  sources = [ "src/ntp_sync_demo.cpp" ]

  include_dirs = [
    "//base/time/time_service/interfaces/inner_api/include",
    "//base/time/time_service/utils/native/include",
  ]

  deps = [
    "//base/time/time_service/interfaces/inner_api:ntp_time_client",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  subsystem_name = "time"
  part_name = "time_service"
}
